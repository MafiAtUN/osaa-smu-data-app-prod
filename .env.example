
# Cloud AI Providers (optional)
# Azure: create an Azure AI resource and copy the key/endpoint/version here.
AZURE_API_KEY=<your-azure-api-key>
AZURE_ENDPOINT=https://<your-azure-endpoint>/
AZURE_API_VERSION=2024-05-01-preview

# GCP / Vertex AI: provide service account JSON path, project, and region.
# The application can use the service account for authentication to Vertex AI.
GCP_SERVICE_ACCOUNT_JSON_PATH=<path/to/gcp-service-account.json>
GCP_PROJECT=<your-gcp-project-id>
GCP_REGION=<your-gcp-region>
GCP_ENDPOINT=https://<your-gcp-vertex-endpoint>/

# AWS (SageMaker/Bedrock): provide AWS credentials and optional endpoint.
# Use IAM roles or a secrets manager in production instead of embedding keys.
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=<your-aws-region>
AWS_SAGEMAKER_ENDPOINT=https://<your-aws-sagemaker-endpoint>/

# Hosted LLM service credentials (optional)
# OpenAI: obtain an API key from the OpenAI dashboard.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_API_BASE=https://<your-openai-api-base> # leave blank for default

# Claude: obtain an API key and endpoint from the Claude provider.
CLAUDE_API_KEY=<your-claude-api-key>
CLAUDE_API_URL=https://<your-claude-api-url>

# Gemini: Google Gemini credentials / endpoint (if applicable).
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_API_URL=https://<your-gemini-api-url>

# Local LLM (Ollama) — optional
# If running Ollama or another local model server, set the base URL (host:port).
# Example: http://localhost:11434
OLLAMA_BASE_URL=http://<your-ollama-host>:11434

# ACLED API Credentials (OAuth)
# Instructions: Create an ACLED account and request API access via the ACLED
# dashboard or support. When you receive your credentials, populate the fields
# below. Keep these values secret and do not commit them to source control.
acled_email=<your-acled-email>
acled_key=<your-acled-api-key-or-password>
ACLED_TOKEN_URL=https://acleddata.com/oauth/token
ACLED_API_URL=https://acleddata.com/api/acled/read

# Public Statistics API (optional)
# Instructions: If using a public statistics or government API, consult the
# provider's documentation to find the base URL and any authentication steps.
# Paste the base URL or endpoint here. Example: https://api.example.org/v1
PUBLIC_STATS_API_URL=https://<your-public-statistics-api-url>

# App Passwords
# Instructions: Use strong, unique passwords for application pages. Store
# production secrets in a secrets manager or environment-specific configuration
# and never commit them to the repository. Prefer the *_HASH variables in
# production. To create one, run: `python scripts/generate_password_hash.py`
APP_PASSWORD_HASH=<pbkdf2-sha256-password-hash>
PID_PASSWORD_HASH=<pbkdf2-sha256-password-hash>
STREAMLIT_SERVER_COOKIE_SECRET=<long-random-cookie-secret>

# Legacy plaintext fallback (avoid in production)
app_password=<app-password>
pid_password=<pid-page-password>

# LangSmith (optional)
# Instructions: Create an account on the LangSmith portal (or vendor portal),
# generate an API key from the dashboard, then paste it here if you plan to
# use LangSmith integrations. Keep the key private.
langsmith=<your-langsmith-api-key>

# Build configuration
SCM_DO_BUILD_DURING_DEPLOYMENT=1
