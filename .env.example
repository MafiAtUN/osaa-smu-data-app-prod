# Azure AI — OSAA account (OpenAI kind)
azure=<your-azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://openai-osaa.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Azure AI — OSAA v2 account (AIServices kind)
AZURE_OPENAI_V2_KEY=<your-osaa-v2-api-key>
AZURE_OPENAI_V2_ENDPOINT=https://openai-osaa-v2.cognitiveservices.azure.com/

# Azure AI — UNGA account
AZURE_OPENAI_UNGA_KEY=<your-unga-azure-openai-api-key>
AZURE_OPENAI_UNGA_ENDPOINT=https://unga-analysis.openai.azure.com/

# Azure AI — UNMISS account (Claude, Grok, Llama, etc.)
AZURE_UNMISS_KEY=<your-unmiss-api-key>
AZURE_UNMISS_ENDPOINT=https://unmiss.cognitiveservices.azure.com/

# Ollama Configuration (local LLMs — optional)
OLLAMA_BASE_URL=http://localhost:11434

# ACLED API Credentials (OAuth)
acled_email=<your-acled-email>
acled_key=<your-acled-password>
ACLED_TOKEN_URL=https://acleddata.com/oauth/token
ACLED_API_URL=https://acleddata.com/api/acled/read

# UN SDG API
UN_SDG_API_URL=https://unstats.un.org/sdgs/UNSDGAPIV5

# App Passwords
app_password=<app-password>
pid_password=<pid-page-password>

# LangSmith (optional)
langsmith=<your-langsmith-api-key>

# Build configuration
SCM_DO_BUILD_DURING_DEPLOYMENT=1
